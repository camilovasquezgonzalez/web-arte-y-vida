---
import type { EventSourceResult } from '../types/event';
import { eventCategories, groupEventsByMonth } from '../lib/events';
import EventCard from './EventCard.astro';
interface Props { agenda: EventSourceResult; }
const { agenda } = Astro.props;
const categories = eventCategories(agenda.items);
const groups = groupEventsByMonth(agenda.items);
---
<div data-agenda-listing data-source-status={agenda.status}>
  {categories.length > 1 && (
    <fieldset hidden data-event-filters class="mb-10">
      <legend class="mb-4 text-sm font-semibold text-brand-white">Explorar por disciplina</legend>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-filter="" aria-pressed="true">Todas</button>
        {categories.map(category => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}
      </div>
    </fieldset>
  )}
  <p data-filter-count role="status" aria-live="polite" aria-atomic="true" class="mb-5 text-sm text-brand-muted">{agenda.items.length ? `${agenda.items.length} ${agenda.items.length === 1 ? 'actividad disponible' : 'actividades disponibles'}` : ''}</p>
  {agenda.status === 'partial' && agenda.items.length > 0 && <p class="mb-6 max-w-2xl text-sm text-brand-muted">Esta selección puede ampliarse. Consulta también las novedades de Reactivemos el Teatro en Tcultura.</p>}
  {groups.map(group => (
    <section data-month-group class="mb-12" aria-labelledby={`month-${group.key}`}>
      <h2 id={`month-${group.key}`} class="mb-6 border-b border-brand-white/15 pb-4 text-2xl capitalize sm:text-3xl">{group.label}</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 2xl:grid-cols-3">
        {group.items.map(event => <EventCard event={event} />)}
      </div>
    </section>
  ))}
  {!agenda.items.length && (
    <section class="max-w-2xl rounded-3xl border border-brand-white/15 bg-brand-white/5 p-6 sm:p-10">
      <h2 class="text-3xl leading-tight">{agenda.status === 'empty' ? 'Estamos preparando nuevas actividades.' : 'Consulta las próximas novedades.'}</h2>
      <p class="mt-4 text-brand-muted">{agenda.status === 'empty' ? 'Mientras tanto, conoce los proyectos y procesos que compartimos con la comunidad.' : 'En este momento no podemos mostrar la programación. Puedes consultar las novedades de Reactivemos el Teatro en Tcultura.'}</p>
      <a href={agenda.status === 'empty' ? '/proyectos' : 'https://tcultura.com/eventos/?ciudad=336'} class="mt-6 inline-flex min-h-12 items-center rounded-full bg-brand-accent px-5 py-3 text-sm font-semibold text-brand-bg">{agenda.status === 'empty' ? 'Conocer nuestros proyectos' : 'Consultar Tcultura ↗'}</a>
      {agenda.status !== 'empty' && <p class="mt-3 text-xs text-brand-muted">Servicio externo · Tcultura</p>}
    </section>
  )}
</div>
<style>
  [data-filter] { min-height: 48px; padding: .7rem 1.2rem; border: 1px solid #f3f1eb55; border-radius: 999px; color: #f3f1eb; cursor: pointer; }
  [data-filter][aria-pressed='true'] { background: #fed100; color: #050505; border-color: #fed100; }
  [data-filter]:hover { border-color: #fed100; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-agenda-listing]').forEach(root => {
    const filters = root.querySelector<HTMLFieldSetElement>('[data-event-filters]');
    if (!filters) return;
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-event-card]'));
    filters.addEventListener('click', event => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-filter]') : null;
      if (!button) return;
      const category = button.dataset.filter;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach(card => { card.hidden = Boolean(category && card.dataset.category !== category); });
      root.querySelectorAll<HTMLElement>('[data-month-group]').forEach(group => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-event-card]')).some(card => !card.hidden);
      });
      const count = cards.filter(card => !card.hidden).length;
      const output = root.querySelector('[data-filter-count]');
      if (output) output.textContent = `${count} ${count === 1 ? 'actividad disponible' : 'actividades disponibles'}${category ? ` · ${category}` : ''}`;
    });
    filters.hidden = false;
  });
</script>
