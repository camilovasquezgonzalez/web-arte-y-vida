---
import type { CulturalEvent } from '../types/event';
import { formatEventDate } from '../lib/events';
interface Props { event: CulturalEvent; }
const { event } = Astro.props;
const closed = /agotad|cancelad|finalizad|cerrad/i.test(event.status);
const href = event.registrationUrl || event.detailUrl;
const label = event.registrationUrl && !closed ? 'Inscribirme' : 'Ver actividad';
---
<article class="event-card flex h-full min-w-0 flex-col rounded-3xl border border-brand-white/15 bg-brand-bg" data-event-card data-category={event.category ?? ''}>
  <div class="px-5 pb-4 pt-6 sm:px-6">
    <time datetime={event.startDate} class="block text-sm font-semibold text-brand-accent">{formatEventDate(event.startDate)}</time>
    <h3 class="mt-3 text-2xl leading-tight">{event.title}</h3>
    {event.category && <p class="mt-3 text-xs font-semibold uppercase tracking-[0.12em] text-brand-secondary">{event.category}</p>}
  </div>
  {event.image && <img src={event.image} alt="" loading="lazy" width="640" height="360" class="aspect-video w-full object-cover" />}
  <div class="flex flex-1 flex-col gap-4 px-5 pb-6 pt-5 sm:px-6">
    <dl class="space-y-2 text-sm text-brand-muted">
      {event.venue && <div><dt class="sr-only">Lugar</dt><dd>{event.venue}{event.locality ? ` · ${event.locality}` : ''}</dd></div>}
      {!event.venue && event.locality && <div><dt class="sr-only">Localidad</dt><dd>{event.locality}</dd></div>}
      <div><dt class="sr-only">Hora</dt><dd class="font-semibold text-brand-white">{event.time} h</dd></div>
    </dl>
    <div class="flex flex-wrap gap-2 text-xs text-brand-white">
      {event.status !== 'unknown' && <span class="rounded-full border border-brand-white/20 px-3 py-1.5">{event.status}</span>}
      {event.free === true && <span class="rounded-full border border-brand-secondary/40 px-3 py-1.5">Gratuita</span>}
      {event.free !== true && event.price && <span>{new Intl.NumberFormat('es-CL', { style: 'currency', currency: event.price.currency }).format(event.price.amount)}</span>}
    </div>
    {event.description && <p class="text-sm leading-relaxed text-brand-muted">{event.description.length > 180 ? `${event.description.slice(0, 177).trimEnd()}…` : event.description}</p>}
    {event.accessibilityInfo && <p class="text-sm text-brand-muted">Accesibilidad: {event.accessibilityInfo}</p>}
    <div class="mt-auto space-y-3 pt-2">
      {href ? <a href={href} aria-label={`${label}: ${event.title}. Servicio externo: ${event.source.label}`} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand-accent px-5 py-3 text-sm font-semibold text-brand-bg hover:bg-brand-white">{label}<span aria-hidden="true">↗</span></a> : <p class="text-sm text-brand-muted">Próximamente más información.</p>}
      <p class="text-xs text-brand-muted">{href ? 'Servicio externo' : 'Publicado en'} · {event.source.label}</p>
    </div>
  </div>
</article>
<style>
  .event-card[hidden] { display: none; }
  .event-card { max-width: 34rem; overflow-wrap: anywhere; }
</style>
