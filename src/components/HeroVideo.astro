---
interface Props {
  videoSrc: string;
  poster?: string;
  title: string;
  kicker?: string;
  description?: string;
  scrollLabel?: string;
  scrollTarget?: string;
}

const { videoSrc, poster, title, kicker, description, scrollLabel = 'Explorar', scrollTarget } = Astro.props as Props;

const fallbackStyle = poster
  ? `background-image: linear-gradient(180deg, rgba(5, 5, 5, 0.12) 0%, rgba(5, 5, 5, 0.28) 100%), url('${poster}');`
  : undefined;
---

<section
  class="hero-video-shell relative flex min-h-[calc(100svh-var(--site-header-height))] w-full items-end overflow-hidden text-white md:min-h-[calc(100svh-var(--site-header-height))] md:items-center"
  data-hero-shell
  data-video-state="fallback"
>
  <div class="hero-video-fallback absolute inset-0 z-0" style={fallbackStyle}></div>

  <video
    muted
    loop
    playsinline
    webkit-playsinline="true"
    disablepictureinpicture
    preload="none"
    poster={poster}
    data-hero-video
    aria-hidden="true"
    class="hero-video absolute inset-0 z-0 h-full w-full object-cover"
  >
    <source src={videoSrc} type="video/mp4" />
    Tu navegador no soporta videos.
  </video>

  <div class="hero-video-overlay absolute inset-0 z-10 pointer-events-none"></div>

  <div class="relative z-20 mx-auto flex h-full w-full max-w-[1280px] items-end px-5 pb-12 pt-28 sm:px-10 sm:pb-14 md:items-center md:py-24">
    <div class="hero-video-content max-w-5xl space-y-5 text-left md:space-y-6">
      {kicker && (
        <span class="block max-w-[22rem] text-xs font-semibold uppercase tracking-[0.18em] text-[#F3D56B] [text-shadow:0_6px_24px_rgba(0,0,0,0.55)] sm:text-sm md:max-w-none md:text-base md:tracking-[0.22em]">
          {kicker}
        </span>
      )}

      <h1 class="max-w-[12ch] text-[clamp(2.7rem,12vw,4.2rem)] leading-[0.92] tracking-tight drop-shadow-[0_12px_34px_rgba(0,0,0,0.42)] md:max-w-[17ch] md:text-6xl lg:text-7xl">
        {title}
      </h1>

      {description && <p class="max-w-2xl text-base leading-relaxed text-brand-white sm:text-lg">{description}</p>}
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
        {scrollLabel && scrollTarget && <a href={`#${scrollTarget}`} class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-accent px-5 py-3 text-center text-sm font-semibold text-brand-bg hover:bg-brand-white">{scrollLabel}</a>}
        <a href="/nuestra-historia" class="inline-flex min-h-12 items-center justify-center rounded-full border border-brand-white/60 bg-brand-bg/50 px-5 py-3 text-center text-sm font-semibold text-brand-white hover:bg-brand-bg">Conoce Arte y Vida</a>
      </div>
      <button type="button" data-video-toggle hidden class="min-h-12 rounded-full border border-brand-white/40 bg-brand-bg/70 px-4 py-3 text-sm text-brand-white">Reproducir video de fondo</button>

    </div>
  </div>
</section>

<style>
  .hero-video-shell {
    background:
      radial-gradient(circle at top right, rgba(49, 204, 231, 0.1), transparent 24%),
      radial-gradient(circle at left center, rgba(197, 48, 149, 0.08), transparent 30%),
      #050505;
  }

  .hero-video-fallback {
    background-color: #050505;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: saturate(0.95) contrast(1.03) brightness(0.85);
    transform: scale(1.02);
  }

  .hero-video {
    opacity: 0;
    transition: opacity 500ms ease;
  }

  .hero-video-overlay {
    background:
      linear-gradient(180deg, rgba(5, 5, 5, 0.24) 0%, rgba(5, 5, 5, 0.48) 100%),
      linear-gradient(90deg, rgba(5, 5, 5, 0.78) 0%, rgba(5, 5, 5, 0.34) 42%, rgba(5, 5, 5, 0.58) 100%);
    backdrop-filter: blur(1.2px);
  }

  .hero-video-shell[data-video-state='paused'] .hero-video,
  .hero-video-shell[data-video-state='playing'] .hero-video {
    opacity: 1;
  }

  .hero-video-shell[data-video-state='playing'] .hero-video-fallback {
    filter: saturate(0.85) contrast(1) brightness(0.72);
  }

  @media (max-width: 767px) {
    .hero-video-overlay {
      background:
        linear-gradient(180deg, rgba(5, 5, 5, 0.4) 0%, rgba(5, 5, 5, 0.58) 54%, rgba(5, 5, 5, 0.8) 100%),
        linear-gradient(90deg, rgba(5, 5, 5, 0.62) 0%, rgba(5, 5, 5, 0.24) 48%, rgba(5, 5, 5, 0.56) 100%);
    }

    .hero-video-content {
      max-width: min(100%, 22rem);
    }
  }

</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-shell]').forEach((shell) => {
    const video = shell.querySelector<HTMLVideoElement>('[data-hero-video]');
    const toggle = shell.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !toggle) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sync = () => {
      toggle.textContent = video.paused ? 'Reproducir video de fondo' : 'Pausar video de fondo';
      shell.dataset.videoState = video.paused ? (video.currentTime > 0 ? 'paused' : 'fallback') : 'playing';
    };
    const play = async () => {
      try { await video.play(); } catch { shell.dataset.videoState = 'fallback'; }
      sync();
    };
    toggle.hidden = false;
    toggle.addEventListener('click', () => { if (video.paused) void play(); else video.pause(); });
    video.addEventListener('playing', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('error', () => {
      video.pause();
      shell.dataset.videoState = 'fallback';
      toggle.hidden = true;
    });
    motion.addEventListener('change', () => { if (motion.matches) video.pause(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); });
    if (!motion.matches) void play();
  });
</script>
