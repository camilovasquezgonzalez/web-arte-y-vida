---
import { programs } from '../data/programs';
import ProgramCard from './ProgramCard.astro';
import SectionHeading from './SectionHeading.astro';
---
<section id="programas" aria-labelledby="programas-heading" class="bg-brand-bg text-brand-white">
  <div class="mx-auto max-w-[1280px] px-5 py-16 sm:px-10 sm:py-20 lg:py-24">
    <SectionHeading id="programas-heading" kicker="Cultura y comunidad" heading="Nuestros programas" description="Cuatro programas para la formación, la programación cultural, la investigación y la relación con el territorio." />
    <div class="mt-9 grid grid-cols-1 gap-5 md:grid-cols-2">
      {programs.map((program, index) => <ProgramCard program={program} index={index} />)}
    </div>
    <a href="/proyectos" class="mt-7 inline-flex min-h-12 items-center gap-3 py-3 font-semibold text-brand-accent hover:underline">Conocer nuestros proyectos <span aria-hidden="true">→</span></a>
  </div>
</section>
