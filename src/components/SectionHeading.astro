---
interface Props {
  id?: string;
  kicker?: string;
  heading: string;
  description?: string;
}
const { id, kicker, heading, description } = Astro.props;
---
<div class="space-y-4 min-w-0">
  {kicker && <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">{kicker}</p>}
  <h2 id={id} class="text-3xl leading-tight sm:text-4xl">{heading}</h2>
  {description && <p class="max-w-2xl text-base leading-relaxed text-brand-muted">{description}</p>}
</div>
