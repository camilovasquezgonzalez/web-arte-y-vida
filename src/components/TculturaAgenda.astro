---
import SectionHeading from './SectionHeading.astro';
import EventCard from './EventCard.astro';
import type { CulturalEvent } from '../types/event';

interface Props {
  items: CulturalEvent[];
  error?: string | null;
  updatedAt?: string;
}

const {
  items,
  error = null,
  updatedAt,
} = Astro.props;

const updatedLabel = updatedAt
  ? new Intl.DateTimeFormat('es-CL', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'America/Santiago',
    }).format(new Date(updatedAt))
  : '';
---

<section id="proximas-actividades" aria-labelledby="agenda-heading" tabindex="-1" class="scroll-mt-24 bg-brand-white/5 text-brand-white">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 items-start gap-10 px-5 py-16 sm:px-10 sm:py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
    <div class="lg:col-span-4 space-y-4">
      <SectionHeading id="agenda-heading" kicker="Encuentro y participación" heading="Próximas actividades" description="Programación disponible de Reactivemos el Teatro" />
      <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href="https://tcultura.com/eventos/?ciudad=336"
          target="_blank"
          rel="noreferrer"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand-accent px-5 py-2.5 text-xs font-black uppercase tracking-[0.2em] text-brand-bg shadow-[0_12px_40px_rgba(254,209,0,0.28)] transition-transform duration-300 hover:-translate-y-[2px]"
        >
          Consultar Tcultura
        </a>
        <span class="text-xs uppercase tracking-[0.18em] text-brand-white/60">
          {items.length > 0 ? `${items.length} ${items.length === 1 ? 'actividad destacada' : 'actividades destacadas'}` : 'Consulta la programación'}
        </span>
      </div>

      {error ? (
        <div class="rounded-3xl border border-brand-secondary/30 bg-brand-secondary/10 px-5 py-4 text-sm leading-relaxed text-brand-white/85">
          {items.length ? error : 'No pudimos actualizar la programación. Puedes consultar la cartelera en Tcultura.'}
        </div>
      ) : (
        <p class="text-sm leading-relaxed text-brand-white/60">
          Reserva tu entrada o revisa los detalles de cada actividad directamente desde la plataforma oficial.
        </p>
      )}
    </div>

    <div class="lg:col-span-8 w-full">
      {items.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {items.slice(0, 3).map(event => <EventCard event={event} />)}
        </div>
      ) : (
        <div class="rounded-3xl border border-brand-white/10 bg-brand-bg/70 backdrop-blur-xl shadow-[0_20px_70px_rgba(0,0,0,0.32)] px-8 py-10">
          <h3 class="text-2xl font-bold leading-tight">{error ? 'Consulta la programación en Tcultura' : 'No hay próximas actividades confirmadas'}</h3>
          <p class="mt-3 text-sm leading-relaxed text-brand-white/70 max-w-2xl">
            Puedes revisar las novedades del proyecto Reactivemos el Teatro directamente en Tcultura.
          </p>
          <div class="mt-6">
            <a
              href="https://tcultura.com/eventos/?ciudad=336"
              target="_blank"
              rel="noreferrer"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-brand-white/15 px-5 py-2.5 text-xs font-black uppercase tracking-[0.2em] text-brand-white/80 transition-colors duration-300 hover:border-brand-accent/50 hover:text-brand-accent"
            >
              Ver programación completa
              <span class="h-2.5 w-2.5 inline-block rotate-45 border-t border-r border-current"></span>
            </a>
          </div>
        </div>
      )}

      <a href="/agenda" class="mt-6 inline-flex min-h-12 items-center gap-2 py-3 font-semibold text-brand-accent">Ver agenda completa <span aria-hidden="true">→</span></a>
      <div class="mt-4 px-1 text-[11px] uppercase tracking-[0.18em] text-brand-white/45">
        Última consulta: {updatedLabel || 'pendiente'}
      </div>
    </div>
  </div>
</section>
