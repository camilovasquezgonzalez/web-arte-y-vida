---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SkipLink from '../components/SkipLink.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = 'Corporación Cultural y Social Arte y Vida, proyectos artísticos y comunitarios desde Coelemu.', canonical } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-brand-bg text-brand-white">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={description}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/blanco-scaled.png" />
    <link rel="apple-touch-icon" href="/blanco-scaled.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title} | Arte y Vida</title>
  </head>
  <body class="flex min-h-screen flex-col bg-brand-bg text-brand-white">
    <SkipLink />
    <SiteHeader />
    <main id="main-content" tabindex="-1" class="relative min-w-0 flex-grow">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style is:global>
  body.mobile-nav-open,
  body.site-menu-open {
    overflow: hidden;
    overscroll-behavior: none;
  }

  img,
  picture,
  video,
  iframe {
    display: block;
    max-width: 100%;
  }

  a,
  button {
    touch-action: manipulation;
  }

  .animate-fade-in {
    animation: fadeIn 1.5s ease-out forwards;
  }

  .animate-reveal-up {
    animation: revealUp 1s ease-out forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
