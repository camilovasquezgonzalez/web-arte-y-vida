---
import Layout from '../layouts/Layout.astro';
const destinations = [
  { title: 'Nuestra historia', href: '/nuestra-historia', text: 'Conoce el origen y el recorrido de Arte y Vida en la comunidad.' },
  { title: 'Equipo, socios y socias', href: '/socios', text: 'Conoce a quienes forman parte de la organización.' },
  { title: 'Transparencia', href: '/transparencia', text: 'Consulta nuestras memorias y documentos institucionales.' },
  { title: 'Contacto', href: '/contacto', text: 'Encuentra los canales para conversar con Arte y Vida.' },
];
---
<Layout title="Nosotros" description="Conoce a Corporación Arte y Vida: cultura, comunidad y territorio desde Coelemu." canonical="https://arteyvida.cl/nosotros">
  <section class="institution-intro" aria-labelledby="nosotros-title">
    <div class="site-container">
      <p class="eyebrow">Cultura · Comunidad · Territorio</p>
      <h1 id="nosotros-title">Nosotros</h1>
      <p class="intro-lead">Arte y Vida nace en Coelemu para activar cultura, comunidad y territorio.</p>
      <p class="intro-text">Somos una corporación cultural y social que trabaja por el desarrollo cultural, social y medioambiental de la comuna y su entorno, articulando artes, patrimonio, naturaleza y participación comunitaria.</p>
    </div>
  </section>
  <section class="institution-links site-container" aria-label="Conoce la organización">
    {destinations.map((item, index) => <a class="institution-card" href={item.href}>
      <span class="card-number" aria-hidden="true">0{index + 1}</span>
      <h2>{item.title}</h2><p>{item.text}</p><span class="card-arrow" aria-hidden="true">↗</span>
    </a>)}
  </section>
  <section class="territory site-container" aria-labelledby="territory-title">
    <p class="eyebrow">Nuestro territorio</p>
    <h2 id="territory-title">Desde Coelemu, en el Valle del Itata.</h2>
    <p>Desde la Región de Ñuble, impulsamos talleres, mediación cultural y acciones medioambientales que fortalecen la identidad local, el bienestar y el tejido social.</p>
    <a href="/nuestra-historia">Explora nuestra historia <span aria-hidden="true">→</span></a>
  </section>
</Layout>
<style>
  .institution-intro { padding-block: 64px 48px; border-bottom: 1px solid #f3f1eb26; }
  .eyebrow { color: #fed100; text-transform: uppercase; letter-spacing: .14em; font-size: 12px; font-weight: 600; }
  h1 { font-size: clamp(3.5rem, 9vw, 7rem); line-height: 1; margin-block: 20px 28px; }
  .intro-lead { max-width: 30ch; font-family: var(--font-display); color: #f3f1eb; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.3; }
  .intro-text { max-width: 720px; margin-top: 24px; line-height: 1.8; }
  .institution-links { display: grid; gap: 16px; padding-block: 40px 64px; }
  .institution-card { position: relative; padding: 28px 24px 52px; border: 1px solid #f3f1eb33; border-radius: 16px; background: #f3f1eb04; }
  .institution-card:hover { border-color: #31cce7; background: #31cce708; }
  .card-number { color: #31cce7; font-size: 12px; font-weight: 600; }
  .institution-card h2 { font-size: 28px; line-height: 1.15; margin-block: 24px 12px; }
  .institution-card p { font-size: 14px; max-width: 44ch; }
  .card-arrow { position: absolute; right: 24px; bottom: 16px; color: #fed100; font-size: 24px; }
  .territory { padding-block: 0 72px; }
  .territory h2 { max-width: 24ch; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-block: 20px; }
  .territory > p:not(.eyebrow) { max-width: 720px; line-height: 1.8; }
  .territory a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: 20px; color: #fed100; text-decoration: underline; text-underline-offset: 5px; }
  @media (min-width: 640px) { .institution-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .institution-intro { padding-block: 80px 64px; } .institution-links { padding-block: 48px 80px; } }
</style>
